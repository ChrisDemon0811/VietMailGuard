{
  "schema_version": 2,
  "policy": {
    "allowed_internal_labels": [
      "normal",
      "spam",
      "phishing"
    ],
    "unmapped_label_action": "preserve_for_review_and_exclude_from_training",
    "mapping_rule": "A raw label may be mapped only after its semantics and corpus provenance are verified.",
    "raw_label_statuses": [
      "normal",
      "spam",
      "phishing",
      "review",
      "exclude"
    ],
    "training_eligible_statuses": [
      "normal",
      "spam",
      "phishing"
    ],
    "review_values_are_not_training_labels": [
      "review",
      "exclude"
    ],
    "raw_label_policy_is_authoritative": true,
    "review_rows_are_training_eligible": false,
    "rule_assisted_proposals_are_ground_truth": false,
    "manual_confirmation_required_for_rule_assisted_proposals": true,
    "semantics_report": "reports/label_semantics_report.md",
    "review_rules": "config/label_review_rules.json",
    "high_confidence_report": "reports/high_confidence_label_report.md",
    "high_confidence_inventory": "reports/high_confidence_label_inventory.csv",
    "baseline_v1": {
      "normal_sources": [
        "CEAS_08.csv:0",
        "Enron.csv:0",
        "Ling.csv:0",
        "SpamAssasin.csv:0"
      ],
      "phishing_sources": [
        "Nazario.csv:1"
      ],
      "spam_requires_manual_confirmation_from": [
        "Ling.csv:1",
        "SpamAssasin.csv:1"
      ],
      "do_not_use_uncurated": [
        "CEAS_08.csv:1",
        "Enron.csv:1"
      ],
      "keep_separate_pending_taxonomy": [
        "Nigerian_Fraud.csv:1"
      ]
    },
    "spam_curation": {
      "source_priority": [
        "SpamAssasin.csv:1",
        "Ling.csv:1",
        "Enron.csv:1",
        "CEAS_08.csv:1"
      ],
      "never_use_for_spam": [
        "Nigerian_Fraud.csv:1"
      ],
      "candidate_input_group": "likely_spam",
      "minimum_distinct_spam_rules": 2,
      "maximum_phishing_or_scam_rules": 0,
      "minimum_body_characters": 120,
      "minimum_body_words": 20,
      "require_unique_exact_content": true,
      "require_unique_template_content": true,
      "rule_candidates_are_ground_truth": false,
      "human_confirmation_required": true,
      "desired_confirmed_spam": 1000,
      "desired_initial_cap": 1500,
      "candidate_report": "reports/spam_curation_candidates.csv",
      "manual_labels": "data/curated/spam_manual_labels.csv",
      "curation_report": "reports/spam_curation_report.md"
    },
    "baseline_freeze_v1": {
      "status": "ready_for_standardization_human_validation_required_before_training",
      "random_seed": 42,
      "target_per_class": 1250,
      "desired_cap": 1500,
      "spam_terminology": "high_confidence_curated_spam",
      "spam_is_manually_confirmed": false,
      "human_validation_required_before_training": true,
      "validation_sample": {
        "SpamAssassin": 35,
        "Ling": 15,
        "Enron": 80,
        "CEAS_08": 20
      },
      "normal_sampling_plan": {
        "CEAS_08": 350,
        "Enron": 350,
        "Ling": 250,
        "SpamAssassin": 300
      },
      "spam_sampling_plan": {
        "SpamAssassin": 351,
        "Ling": 66,
        "Enron": 733,
        "CEAS_08": 100
      },
      "phishing_sampling_plan": {
        "Nazario": 1250
      },
      "exclude_exact_duplicates": true,
      "exclude_template_duplicates": true,
      "eligibility_dataset": "data/processed/baseline_eligibility.csv",
      "sampling_manifest": "reports/baseline_sampling_manifest.csv",
      "validation_report": "reports/spam_validation_sample.csv",
      "outstanding_review_report": "reports/spam_curation_needs_human_review.csv",
      "plan_report": "reports/baseline_dataset_plan.md"
    },
    "standardization": {
      "output": "data/processed/English_Master_Dataset.csv",
      "removed_rows_report": "reports/removed_rows.csv",
      "duplicate_report": "reports/duplicate_report.csv",
      "review_rows_report": "reports/standardization_review_rows.csv",
      "summary_report": "reports/standardization_summary.csv",
      "unicode_form": "NFC",
      "placeholder_values": [
        "empty",
        "none",
        "null",
        "nan",
        "n/a",
        "na"
      ],
      "body_is_required": true,
      "container_artifact_patterns": [
        "this text is part of the internal format of your mail folder, and is not a real message"
      ],
      "exact_duplicate_action": "keep_first_canonical_and_report_removed_copies",
      "template_duplicate_action": "keep_distinct_rows_grouped_by_group_id",
      "conflicting_template_label_action": "exclude_entire_group_and_report",
      "row_level_spam_override": {
        "source_report": "reports/spam_curation_candidates.csv",
        "candidate_group": "high_confidence_curated_spam",
        "required_proposed_label": "spam",
        "mapped_label": "spam",
        "label_provenance": "high_confidence_curated_spam",
        "manual_confirmation_claimed": false
      },
      "output_schema": [
        "id",
        "original_row_id",
        "sender",
        "receiver",
        "date",
        "subject",
        "body",
        "label",
        "raw_label",
        "source",
        "language",
        "url_count",
        "content_hash",
        "group_id",
        "label_provenance"
      ]
    },
