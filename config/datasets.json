        "validation": 0.15,
        "test": 0.15
      },
      "group_column": "group_id",
      "stratify_column": "label",
      "outputs": {
        "train": "data/splits/train.csv",
        "validation": "data/splits/validation.csv",
        "test": "data/splits/test.csv"
      },
      "report": "reports/split_report.json",
      "leakage_checks": [
        "group_id",
        "content_hash",
        "normalized_content_hash",
        "template_hash"
      ]
    }
