# Optional Gemini Reviewer. Keep real credentials only in the untracked .env file.
VIETMAILGUARD_V21_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional UI Reviewer wait limit in seconds (greater than 0, at most 60).
# Each explicit UI click makes one attempt; automatic retries are disabled.
GEMINI_REVIEW_TIMEOUT_SECONDS=30
