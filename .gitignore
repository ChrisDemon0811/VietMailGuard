# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.local-test-deps/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets and environment overrides
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# Private mail exports are local inputs, even when placed outside data/raw/.
*.eml
*.mbox
*.msg
*.pst
*.ost

# Local runtime, checkpoints, and large binary artifacts (including stray copies).
*.db
*.sqlite
*.sqlite3
*.ckpt
*.checkpoint*
*.joblib
*.safetensors
checkpoints/

# Generated data, reports, results, and model artifacts
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/curated/*
data/evaluation/*
data/runtime/*
!data/runtime/.gitkeep
models/*
!models/.gitkeep
!models/v2_bilingual/
models/v2_bilingual/*
!models/v2_bilingual/model_metadata.json

results/*
!results/.gitkeep
!results/v2_bilingual/
results/v2_bilingual/*
!results/v2_bilingual/final_test_metrics.json
!results/v2_bilingual/final_test_classification_report.csv
!results/v2_bilingual/final_confusion_matrix.csv
!results/v2_bilingual/tfidf_model_comparison.csv
!results/v2_bilingual/multilingual_embedding_validation.csv

reports/*
!reports/.gitkeep
!reports/dataset_license_audit.md
!reports/repository_tracking_policy.md
!reports/v2/
reports/v2/*
!reports/v2/model_selection_rationale.md
!reports/v2/final_model_evaluation.md
!reports/v2/version2_completion_report.md

# Raw datasets are immutable local inputs. Keep only the directory marker.
data/raw/*
!data/raw/.gitkeep

# Version 2.1 local datasets and generated artifacts. Keep directory markers only.
/dataset v2.1/
/data/v21/**/*
!/data/v21/**/
!/data/v21/**/.gitkeep

# V2.1 local configuration may contain private source paths or credentials.
/config/v21/*.local.*
/config/v21/*secret*
/config/v21/*credential*
/config/v21/*api_key*
/config/v21/private/

# V2.1 binaries/results/reports remain local until independently reviewed.
!models/v21_multilingual/
models/v21_multilingual/*
!models/v21_multilingual/.gitkeep
!results/v21_multilingual/
results/v21_multilingual/*
!results/v21_multilingual/.gitkeep
!reports/v21/
reports/v21/*
!reports/v21/.gitkeep
!reports/v21/research_preview_qa.md
!reports/v21/git_release_preflight.md
